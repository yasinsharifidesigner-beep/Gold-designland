# PostgreSQL (Liara managed database). Leave empty locally to use SQLite.
DATABASE_URL=

# SQLite file used when DATABASE_URL is empty. On Liara this file is wiped on
# every deploy unless a disk is mounted at this folder.
DB_PATH=./data/gdl.sqlite

# Owner login for /admin. Both are required; otherwise admin login stays off.
# Use ADMIN_PASSWORD_HASH (bcrypt) instead of ADMIN_PASSWORD if you prefer.
ADMIN_PHONE=
ADMIN_PASSWORD=

SESSION_SECRET=change-me
# PAYMENT_MOCK_RESULT=fail

# Raz Payamak shared-line OTP (payamak-panel / Melipayamak white-label).
# All three must be set or local dev keeps the demo code 42971 and sends nothing.
# RAZ_API_KEY is the panel password. Never commit it.
RAZ_USERNAME=
RAZ_API_KEY=
RAZ_BODY_ID=
