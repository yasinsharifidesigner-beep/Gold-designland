<%- include('open', { bare: true, title: 'ورود مدیر', active: '' }) %>
<article class="card">
  <div class="logo"></div>
  <div class="brand">گولد دیزاین لند</div>
  <h2>ورود مدیر</h2>
  <% if (!enabled) { %>
    <p class="err" style="text-align:right">ورود مدیر خاموش است. ADMIN_PHONE و ADMIN_PASSWORD را در محیط سرور بگذار.</p>
  <% } else { %>
    <form method="post" action="/admin/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input class="afield phone" name="phone" inputmode="numeric" placeholder="شماره موبایل" value="<%= phone || '' %>" autocomplete="username">
      <input class="afield" type="password" name="password" placeholder="رمز عبور" autocomplete="current-password">
      <button class="btn" type="submit">ورود</button>
    </form>
    <% if (error) { %><p class="err"><%= error %></p><% } %>
  <% } %>
</article>
<%- include('close', { bare: true }) %>
