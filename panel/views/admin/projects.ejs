<%- include('open', { bare: false, active: 'projects', title: 'پروژه‌ها' }) %>
<header class="head"><h1 class="h1s">پروژه‌ها</h1></header>
<form class="toolsbar" method="get" action="/admin/projects">
  <input class="grow" type="search" name="q" value="<%= q %>" placeholder="عنوان یا نام کاربر" aria-label="جست‌وجو">
  <button class="btn" type="submit">جست‌وجو</button>
</form>
<div class="table-wrap">
  <table class="atable">
    <thead><tr><th>عنوان</th><th>کاربر</th><th>مرحله</th><th>زمان</th></tr></thead>
    <tbody>
      <% rows.forEach(function (p) { %>
        <tr>
          <td><a class="rowlink" href="/admin/projects/<%= p.slug %>"><%= p.title %></a></td>
          <td><%= p.userName %></td>
          <td><%= p.stage %></td>
          <td><%= p.when %></td>
        </tr>
      <% }) %>
      <% if (!rows.length) { %><tr><td colspan="4">پروژه‌ای پیدا نشد.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('pager') %>
<%- include('close', { bare: false }) %>
