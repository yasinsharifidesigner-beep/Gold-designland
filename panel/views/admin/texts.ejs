<%- include('open', { bare: false, active: 'texts', title: 'متن‌های سایت' }) %>
<header class="head"><h1 class="h1s">متن‌های سایت</h1><p class="sub">تغییرها همان لحظه روی صفحهٔ اصلی، ورود و پنل دیده می‌شود.</p></header>
<form class="toolsbar" method="get" action="/admin/texts">
  <% if (group) { %><input type="hidden" name="g" value="<%= group %>"><% } %>
  <input class="grow" type="search" name="q" value="<%= q %>" placeholder="واژه در متن یا کلید" aria-label="جست‌وجو">
  <button class="btn" type="submit">جست‌وجو</button>
</form>
<div class="tabs-mini">
  <a class="<%= group ? '' : 'on' %>" href="/admin/texts<%= q ? '?q=' + encodeURIComponent(q) : '' %>">همهٔ صفحه‌ها</a>
  <% groups.forEach(function (g) {
    const params = new URLSearchParams();
    params.set('g', g.id);
    if (q) params.set('q', q);
  %>
    <a class="<%= g.id === group ? 'on' : '' %>" href="/admin/texts?<%= params.toString() %>"><%= g.label %></a>
  <% }) %>
</div>
<div class="table-wrap">
  <table class="atable">
    <thead><tr><th>صفحه</th><th>جایگاه</th><th>متن</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach(function (row) { %>
        <tr>
          <td><span class="badge"><%= row.pageLabel %></span></td>
          <td class="where"><%= row.location %></td>
          <td class="tval"><%= row.value %></td>
          <td><a class="rowlink" href="/admin/texts/<%= encodeURIComponent(row.key) %>">ویرایش</a></td>
        </tr>
      <% }) %>
      <% if (!rows.length) { %><tr><td colspan="4">متنی پیدا نشد.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('pager') %>
<%- include('close', { bare: false }) %>
