<%- include('open', { bare: false, active: 'users', title: 'کاربرها' }) %>
<header class="head"><h1 class="h1s">کاربرها</h1><p class="sub">جست‌وجو با نام یا شمارهٔ موبایل.</p></header>
<form class="toolsbar" method="get" action="/admin/users">
  <input class="grow" type="search" name="q" value="<%= q %>" placeholder="نام یا شماره" aria-label="جست‌وجو">
  <button class="btn" type="submit">جست‌وجو</button>
</form>
<div class="table-wrap">
  <table class="atable">
    <thead><tr><th>نام</th><th>موبایل</th><th>اشتراک</th><th>وضعیت</th><th>عضویت</th></tr></thead>
    <tbody>
      <% rows.forEach(function (u) { %>
        <tr>
          <td><a class="rowlink" href="/admin/users/<%= u.id %>"><%= u.firstName %> <%= u.lastName %></a></td>
          <td class="num"><%= fa(u.phone) %></td>
          <td><%= u.subscription ? u.subscription.name : '—' %></td>
          <td><% if (u.blocked) { %><span class="badge off">مسدود</span><% } else { %><span class="badge">فعال</span><% } %></td>
          <td class="num"><%= when(u.createdAt) %></td>
        </tr>
      <% }) %>
      <% if (!rows.length) { %><tr><td colspan="5">کسی پیدا نشد.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('pager') %>
<%- include('close', { bare: false }) %>
