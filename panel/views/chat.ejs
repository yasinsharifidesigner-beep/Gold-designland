<%- include('partials/open', { active, mainClass: 'talk', title: heading }) %>
<header class="cbar">
  <% if (back) { %><a class="back" href="<%= back.href %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 5l7 7-7 7"/></svg><%= back.label %></a><% } else { %><span class="cbar-sp"></span><% } %>
  <h1><%= heading %></h1>
  <span class="cbar-sp"></span>
</header>
<div class="thread">
  <% messages.forEach(function (m) { %>
    <% if (m.type === 'photo') { %>
      <div class="msg <%= m.role === 'user' ? 'me photo' : 'asst' %>"><%- include('partials/sketch', { shape: 'ring' }) %></div>
    <% } else if (m.role === 'user') { %>
      <div class="msg me"><%= m.text %></div>
    <% } else { %>
      <div class="msg asst"><%= m.text %></div>
    <% } %>
  <% }) %>
  <% if (card) { %>
    <section class="qcard <%= card.side ? 'side' : '' %>">
      <h2><%= card.title %></h2>
      <% (card.groups || [{ label: '', chips: card.chips, breakAfter: 0 }]).forEach(function (g) { %>
        <% if (g.label) { %><div class="gl"><%= g.label %></div><% } %>
        <div class="chips">
          <% g.chips.forEach(function (chip, i) { %>
            <% if (g.breakAfter && i === g.breakAfter) { %><i class="br"></i><% } %>
            <form method="post" action="<%= action %>" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="chip" value="<%= chip %>">
              <input type="hidden" name="group" value="<%= g.label %>">
              <button class="chip <%= card.picked && card.picked[g.label] === chip ? 'on' : '' %>" type="submit"><%= chip %></button>
            </form>
          <% }) %>
        </div>
      <% }) %>
      <% if (card.confirm) { %>
        <form method="post" action="<%= action %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="confirm" value="1">
          <button class="btn form go" type="submit">تأیید و دیدن طرح‌ها</button>
        </form>
      <% } %>
      <% if (card.build) { %>
        <form method="post" action="<%= action %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="build" value="1">
          <button class="btn form go" type="submit">بساز</button>
        </form>
      <% } %>
      <% if (card.progress) { %>
        <div class="prog"><span>مرحلهٔ <%= card.progress.label %></span><b><i style="width:<%= card.progress.pct %>"></i></b></div>
      <% } %>
    </section>
  <% } %>
  <% if (typing) { %><div class="typing">در حال نوشتن…</div><% } %>
  <% if (error) { %><p class="err"><%= error %></p><% } %>
</div>
<form class="composer w760" method="post" action="<%= action %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="text" name="text" placeholder="<%= placeholder %>" aria-label="<%= placeholder %>">
  <button class="attach" type="button" title="پیوست تصویر مرجع" aria-label="پیوست تصویر مرجع"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3.5" y="5" width="17" height="14" rx="2.2"/><circle cx="9" cy="10.2" r="1.6"/><path d="M3.8 16.2 8.5 12l3.2 2.6 3-3.4 5.5 5.2"/></svg></button>
  <button class="send" type="submit" title="ارسال" aria-label="ارسال"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg></button>
</form>
<%- include('partials/close', { auth: false }) %>
