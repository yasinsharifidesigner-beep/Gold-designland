<%- include('partials/open', { active: 'sub', mainClass: 'dash', title: t('sub.checkoutTitle') }) %>
<a class="backlink" href="/panel/subscription"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 5l7 7-7 7"/></svg><%= t('sub.back') %></a>
<h1 class="h1s" style="margin-top:10px"><%= t('sub.checkoutTitle') %></h1>
<div class="wrapc">
  <section class="buy">
    <h2><%= t('sub.planName', { name: plan.name }) %></h2>
    <div class="term"><%= t('sub.term') %></div>
    <ul class="feats"><% plan.features.forEach(function (f) { %><li><svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#CDAE62"/><path d="M7.5 12.3l3 3.1 6-6.2" fill="none" stroke="#1F1E1C" stroke-width="2" stroke-linecap="round"/></svg><span><%= f %></span></li><% }) %></ul>
    <div class="price"><b class="num"><%= money(plan.price) %></b><span><%= t('sub.toman') %></span></div>
    <form class="code" method="post" action="/panel/subscription/<%= plan.code %>/discount">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input name="code" placeholder="<%= t('sub.codePh') %>" aria-label="<%= t('sub.codePh') %>" value="<%= code || '' %>">
      <button class="btn-sec" type="submit"><%= t('sub.apply') %></button>
    </form>
    <%- include('partials/toast-seed', { kind: 'error', text: error }) %>
    <%- include('partials/toast-seed', { kind: 'success', text: ok }) %>
    <div class="bill">
      <div><em><%= t('sub.amount') %></em><strong class="num"><%= money(plan.price) %> <%= t('sub.toman') %></strong></div>
      <div><em><%= t('sub.discount') %></em><strong class="num"><%= money(discount) %> <%= t('sub.toman') %></strong></div>
      <div class="total"><em><%= t('sub.final') %></em><strong class="num"><%= money(finalAmount) %> <%= t('sub.toman') %></strong></div>
    </div>
    <form method="post" action="/panel/subscription/pay" style="margin-top:20px">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="plan" value="<%= plan.code %>">
      <button class="btn pay" type="submit"><%= t('sub.pay') %></button>
    </form>
    <p class="note"><%= t('sub.payNote') %></p>
  </section>
</div>
<%- include('partials/close', { auth: false }) %>
