<%- include('partials/open', { active: 'courses', mainClass: 'two', title: course.title }) %>
<div class="layout">
  <aside class="slist">
    <h1><%= course.title %></h1>
    <div class="cprog" style="margin-bottom:16px"><b><i style="width:<%= pct %>"></i></b><span><%= pct %></span></div>
    <ol class="sessions">
      <% course.sessions.forEach(function (s) { const st = watched.includes(s.n) ? 'done' : (s.n === current.n ? 'now' : 'soon'); %>
        <li><a class="<%= st %>" href="/panel/courses/<%= course.slug %>/<%= s.n %>">
          <span class="mark"><% if (st === 'done') { %><svg width="18" height="18" viewBox="0 0 24 24"><defs><linearGradient id="gld" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#FFF6DA"/><stop offset="35%" stop-color="#F1DA9A"/><stop offset="65%" stop-color="#DDBE74"/><stop offset="100%" stop-color="#BF9B52"/></linearGradient></defs><circle cx="12" cy="12" r="10" fill="url(#gld)"/><path d="M7.5 12.3l3 3.1 6-6.2" fill="none" stroke="#1F1E1C" stroke-width="2" stroke-linecap="round"/></svg><% } else { %><%= fa(s.n) %><% } %></span>
          <span class="t"><%= s.title %></span>
        </a></li>
      <% }) %>
    </ol>
  </aside>
  <section class="watch">
    <div class="player">
      <div class="vstage">
        <video id="vid" poster="" style="width:100%;height:100%;object-fit:cover" <% if (current.videoUrl) { %>src="<%= current.videoUrl %>"<% } %> data-end="/panel/courses/<%= course.slug %>/<%= current.n %>/seen"></video>
        <button class="play" type="button" id="play" aria-label="<%= t('common.play') %>"><svg width="30" height="30" viewBox="0 0 24 24" style="margin-right:-3px"><path d="M8 5v14l12-7z" fill="#1F1E1C"/></svg></button>
      </div>
      <div class="ctrl">
        <button type="button" aria-label="<%= t('common.play') %>"><svg width="16" height="16" viewBox="0 0 24 24"><path d="M8 5v14l12-7z" fill="#F4EFE4"/></svg></button>
        <span class="num">۰۵:۲۰</span>
        <div class="scrub"><i></i></div>
        <span class="num"><%= current.duration || '۱۶:۴۵' %></span>
        <button type="button" aria-label="<%= t('common.sound') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.7"><path d="M4 10v4h4l5 4V6L8 10H4z"/></svg></button>
        <button type="button" id="full" aria-label="<%= t('common.full') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4EFE4" stroke-width="1.7"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
      </div>
    </div>
    <h2><%= t('common.sessionTitle', { n: fa(current.n), title: current.title }) %></h2>
    <% if (current.description) { %><p class="desc"><%= current.description %></p><% } %>
    <div class="actions">
      <% if (prev) { %><a class="btn-sec" href="/panel/courses/<%= course.slug %>/<%= prev %>"><%= t('common.prevSession') %></a><% } %>
      <% if (next) { %><a class="btn" href="/panel/courses/<%= course.slug %>/<%= next %>"><%= t('common.nextSession') %></a><% } %>
    </div>
  </section>
</div>
<%- include('partials/close', { auth: false }) %>
