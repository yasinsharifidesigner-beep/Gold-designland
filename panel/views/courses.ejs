<%- include('partials/open', { active: 'courses', mainClass: 'dash', title: t('courses.title') }) %>
<header class="head gap"><h1 class="h1s"><%= t('courses.title') %></h1><p class="sub"><%= t('courses.sub') %></p></header>
<div class="ccols">
  <% courses.forEach(function (c) { %>
    <article class="ccard">
      <div class="cover" aria-label="<%= c.title %>"><%- include('partials/sketch', { shape: c.slug === 'matrix-intro' ? 'ring' : 'square' }) %></div>
      <div class="cbody">
        <div class="cprog"><b><i style="width:<%= c.pct %>"></i></b><span><%= c.pct %></span></div>
        <a class="btn sm" href="/panel/courses/<%= c.slug %>"><%= t('courses.continue') %></a>
      </div>
    </article>
  <% }) %>
</div>
<%- include('partials/close', { auth: false }) %>
