<%- include('partials/open', { active: 'desk', mainClass: 'dash', title: t('dash.title') }) %>
<header class="head">
  <h1 class="h1"><%= t('dash.title') %></h1>
  <p class="sub"><%= empty ? t('dash.helloEmpty', { name: user.firstName }) : t('dash.helloWork', { name: user.firstName }) %></p>
</header>
<div class="grid3">
  <section class="w proj">
    <div class="wh">
      <span class="wi"><%- include('partials/ico', { name: 'grid' }) %></span>
      <h2><%= t('dash.projects') %></h2>
      <% if (!empty) { %><a class="more" href="/panel/projects"><%= t('common.seeAll') %></a><% } %>
    </div>
    <% if (empty) { %>
      <div class="proj-empty">
        <span class="ill"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 4h10l4 5-9 11L3 9z"/><path d="M3 9h18M9.5 4 8 9l4 11 4-11-1.5-5"/></svg></span>
        <p><%= t('dash.noProject') %></p>
        <a class="ebtn" href="/panel/chats/idea"><%= t('dash.startProject') %></a>
      </div>
      <div class="path">
        <div class="path-l"><%= t('dash.path') %></div>
        <%- include('partials/track', { now: 0, fill: '0%', small: false, links: null }) %>
      </div>
    <% } else { %>
      <div class="prs">
        <% projects.forEach(function (p) { %>
          <a class="pr" href="/panel/projects/<%= p.slug %>">
            <div class="pr-top"><span class="th"><%- include('partials/sketch', { shape: p.shape }) %></span><h4><%= p.title %></h4></div>
            <%- include('partials/track', { now: p.now, fill: p.fill, small: false, links: null }) %>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
  <section class="w">
    <div class="wh"><span class="wi"><%- include('partials/ico', { name: 'lamp' }) %></span><h2><%= t('dash.ideas') %></h2><% if (!empty) { %><a class="more" href="/panel/chats/idea"><%= t('common.seeAll') %></a><% } %></div>
    <% if (empty) { %>
      <div class="empty"><p><%= t('dash.noIdea') %></p><a class="ebtn" href="/panel/chats/idea"><%= t('dash.startIdea') %></a></div>
    <% } else { %>
      <div class="list"><% ideas.forEach(function (c) { %><a class="row" href="/panel/chats/idea/<%= c.id %>"><span class="rt"><%= c.title %></span><span class="rm"><%= c.when %></span></a><% }) %></div>
    <% } %>
  </section>
  <section class="w">
    <div class="wh"><span class="wi"><%- include('partials/ico', { name: 'box' }) %></span><h2><%= t('dash.asks') %></h2><% if (!empty) { %><a class="more" href="/panel/chats/assistant"><%= t('common.seeAll') %></a><% } %></div>
    <% if (empty) { %>
      <%- include('partials/ring', { num: fa(giftLeft), label: t('dash.gift', { total: fa(user.giftTotal) }), offset: 0, big: false }) %>
      <div class="empty"><p><%= t('dash.noAsk') %></p><a class="ebtn" href="/panel/chats/assistant"><%= t('dash.firstAsk') %></a></div>
    <% } else { %>
      <div class="usage"><div class="ubar"><i style="width:<%= user.giftTotal ? Math.round((user.giftTotal - giftLeft) / user.giftTotal * 100) : 0 %>%"></i></div><span><%= fa(giftLeft) %> <%= t('dash.gift', { total: fa(user.giftTotal) }) %></span></div>
      <div class="list"><% asks.forEach(function (c) { %><a class="row" href="/panel/chats/assistant/<%= c.id %>"><span class="rt"><%= c.title %></span><span class="rm"><%= c.when %></span></a><% }) %></div>
    <% } %>
  </section>
  <section class="w">
    <div class="wh"><span class="wi"><%- include('partials/ico', { name: 'cam' }) %></span><h2><%= t('dash.shots') %></h2><% if (!empty) { %><a class="more" href="/panel/chats/image"><%= t('common.seeAll') %></a><% } %></div>
    <% if (empty) { %>
      <div class="tiles"><% for (let i=0;i<4;i++) { %><div class="sg"></div><% } %></div>
      <div class="empty"><p><%= t('dash.noShot') %></p><a class="ebtn" href="/panel/chats/image"><%= t('nav.image') %></a></div>
    <% } else { %>
      <div class="shots"><% shots.forEach(function (s) { %><a class="shot" href="/panel/chats/image/<%= s.chatId %>"><%- include('partials/sketch', { shape: 'ring' }) %></a><% }) %></div>
    <% } %>
  </section>
</div>
<%- include('partials/close', { auth: false }) %>
