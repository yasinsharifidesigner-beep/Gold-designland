<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<title><%= t('landing.title') %></title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
(function(){try{var s=localStorage.getItem('gdl-theme');var t=(s==='light'||s==='dark')?s:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');var h=document.documentElement;h.setAttribute('data-theme',t);h.style.backgroundColor=t==='dark'?'#071A33':'#FAF8F4';h.style.colorScheme=t;}catch(e){}})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;600;700&family=Noto+Naskh+Arabic:wght@400;500;600&family=Cormorant+Garamond:wght@600;700&display=swap">
<link rel="stylesheet" href="styles.css">
<script src="/ui/js/theme.js" defer></script>
<script src="main.js" defer></script>
</head>
<body>
<div dir="rtl" lang="fa" style="min-height:100vh;background:var(--bg);color:var(--ink);font-family:'Noto Naskh Arabic',serif;font-size:17px;line-height:2">

<header class="site-head" style="position:sticky;top:0;z-index:50;backdrop-filter:blur(12px);border-bottom:1px solid var(--line)">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:16px;height:72px">
    <a href="#hero" style="display:flex;flex-direction:column;align-items:flex-start;line-height:1;direction:ltr;flex:none">
      <span class="gt" style="font-family:'Cormorant Garamond',serif;font-weight:700;font-size:34px;letter-spacing:.04em">GDL</span>
      <span style="font-family:'Cormorant Garamond',serif;font-size:8px;letter-spacing:.32em;color:var(--muted);margin-top:2px"><%= t('landing.brandSub') %></span>
    </a>
    <nav class="dn" style="display:flex;align-items:center;gap:22px">
      <a class="nl" href="#ideation"><%= t('landing.nav.idea') %></a>
      <a class="nl" href="#assistant"><%= t('landing.nav.assistant') %></a>
      <a class="nl" href="#roadmap"><%= t('landing.nav.roadmap') %></a>
      <a class="nl" href="#faq"><%= t('landing.nav.faq') %></a>
      <a class="nl" href="#gift" style="display:inline-flex;align-items:center;gap:6px;color:var(--gold-text);font-weight:600;border:1px solid var(--gold-text);border-radius:999px;padding:6px 16px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg><%= t('landing.nav.gift') %></a>
    </nav>
    <div style="display:flex;align-items:center;gap:10px">
      <button class="icbtn land-toggle" type="button" data-theme-toggle aria-label="<%= t('landing.theme') %>" title="<%= t('landing.theme') %>"><svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg><svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"/></svg></button>
      <a class="btn gold" href="/auth/login" style="padding:10px 20px;font-size:13px;text-align:center"><%= t('landing.login') %></a>
      <button class="icbtn dm" id="menu-btn" type="button" aria-label="<%= t('landing.menu') %>"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M4 6h16"/><path d="M4 18h16"/></svg></button>
    </div>
  </div>
  <div class="dm" id="menu" style="display:none;flex-direction:column;gap:4px;padding:8px 24px 20px;border-top:1px solid var(--line);background:var(--bg)">
    <a class="nl" href="#ideation" style="padding:10px 0"><%= t('landing.nav.idea') %></a>
    <a class="nl" href="#assistant" style="padding:10px 0"><%= t('landing.nav.assistant') %></a>
    <a class="nl" href="#roadmap" style="padding:10px 0"><%= t('landing.nav.roadmap') %></a>
    <a class="nl" href="#faq" style="padding:10px 0"><%= t('landing.nav.faq') %></a>
    <a class="nl" href="#gift" style="padding:10px 0;color:var(--gold-text);font-weight:600"><%= t('landing.nav.gift') %></a>
  </div>
</header>

<section id="hero" class="sec" style="padding-top:80px">
  <div class="wrap two">
    <div>
      <h1 class="rv"><%= t('landing.hero.before') %> <span class="gt"><%= t('landing.hero.em') %></span> <%= t('landing.hero.after') %></h1>
      <div class="ctas rv" style="display:flex;gap:14px;margin-top:44px;flex-wrap:wrap;transition-delay:.15s">
        <a class="btn gold" href="/auth/login"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg><%= t('landing.hero.cta') %></a>
        <a class="btn out" href="#roadmap"><%= t('landing.hero.road') %></a>
      </div>
    </div>
    <div class="ph rv" style="aspect-ratio:4/5;width:100%;max-width:520px;justify-self:center;transition-delay:.2s"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></div>
  </div>
</section>

<section id="ideation" class="sec">
  <div class="wrap two">
    <div>
      <h2 class="rv"><%= t('landing.idea.before') %> <span class="gt"><%= t('landing.idea.em') %></span> <%= t('landing.idea.after') %></h2>
      <div class="rv" style="display:flex;flex-direction:column;gap:18px;margin:36px 0 40px;transition-delay:.1s">
        <div style="display:flex;align-items:center;gap:14px;font-size:18px"><span style="color:var(--gold-text);display:flex"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg></span><%= t('landing.idea.f1') %></div>
        <div style="display:flex;align-items:center;gap:14px;font-size:18px"><span style="color:var(--gold-text);display:flex"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg></span><%= t('landing.idea.f2') %></div>
        <div style="display:flex;align-items:center;gap:14px;font-size:18px"><span style="color:var(--gold-text);display:flex"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></span><%= t('landing.idea.f3') %></div>
      </div>
      <a class="btn gold rv" href="/auth/login" style="transition-delay:.2s"><%= t('landing.idea.cta') %></a>
    </div>
    <div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <div class="ph rv" style="aspect-ratio:1;border-radius:20px;transition-delay:0s"></div>
        <div class="ph rv" style="aspect-ratio:1;border-radius:20px;transition-delay:.15s"></div>
        <div class="ph rv" style="aspect-ratio:1;border-radius:20px;transition-delay:.3s"></div>
        <div class="ph rv" style="aspect-ratio:1;border-radius:20px;transition-delay:.45s"></div>
      </div>
      <div class="rv" style="margin-top:16px;display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:999px;padding-right:24px;transition-delay:.5s">
        <span style="flex:1;color:var(--muted);font-size:16px;min-width:0"><%= t('landing.idea.sample') %></span>
        <a class="btn gold" href="/auth/login" style="padding:9px 24px;font-size:14px"><%= t('landing.idea.build') %></a>
      </div>
    </div>
  </div>
</section>

<section id="assistant" class="sec" style="background:var(--bg2)">
  <div class="wrap two">
    <div>
      <h2 class="rv"><%= t('landing.assist.h') %></h2>
      <p class="rv" style="color:var(--muted);margin:24px 0 36px;max-width:460px;transition-delay:.1s"><%= t('landing.assist.p') %></p>
      <a class="btn gold rv" href="/auth/login" style="transition-delay:.2s"><%= t('landing.assist.cta') %></a>
    </div>
    <div style="background:var(--card);border:1px solid var(--line);border-radius:28px;padding:24px;display:flex;flex-direction:column;gap:14px">
      <div style="display:flex;align-items:center;gap:10px;padding-bottom:14px;border-bottom:1px solid var(--line)">
        <span style="width:34px;height:34px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-weight:700;font-size:13px;direction:ltr;color:#1F1E1C">GDL</span>
        <span class="k" style="font-size:14px;font-weight:600"><%= t('landing.assist.name') %></span>
      </div>
      <div class="rv" style="align-self:flex-start;max-width:85%;background:var(--bg2);border-radius:20px;border-top-right-radius:6px;padding:10px 18px;font-size:16px"><%= t('landing.assist.m1') %></div>
      <div class="rv" style="align-self:flex-end;max-width:90%;border:1px solid var(--line);border-radius:20px;border-top-left-radius:6px;padding:10px 18px;font-size:16px;transition-delay:.25s"><%= t('landing.assist.m2') %></div>
      <div class="rv" style="align-self:flex-start;max-width:85%;background:var(--bg2);border-radius:20px;border-top-right-radius:6px;padding:10px 18px;font-size:16px;transition-delay:.5s"><%= t('landing.assist.m3') %></div>
      <div class="rv" style="align-self:flex-end;max-width:90%;border:1px solid var(--line);border-radius:20px;border-top-left-radius:6px;padding:10px 18px;font-size:16px;transition-delay:.75s"><%= t('landing.assist.m4') %></div>
    </div>
  </div>
</section>

<section id="roadmap" class="sec">
  <div class="wrap">
    <h2 class="rv" style="text-align:center"><%= t('landing.road.before') %> <span class="gt"><%= t('landing.road.em') %></span></h2>

    <div class="rm rm-d" data-rm="1" style="height:330px;margin:72px 0 24px">
      <svg viewBox="0 0 1200 330" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible">
        <path d="M1200 100 L1100 100 C1000 100 1000 190 900 190 C800 190 800 100 700 100 C600 100 600 190 500 190 C400 190 400 100 300 100 C200 100 200 190 100 190 L0 190" fill="none" stroke="#E4DFD6" stroke-width="2" vector-effect="non-scaling-stroke"/>
        <path data-path="1" d="M1200 100 L1100 100 C1000 100 1000 190 900 190 C800 190 800 100 700 100 C600 100 600 190 500 190 C400 190 400 100 300 100 C200 100 200 190 100 190 L0 190" fill="none" stroke="#B8964A" stroke-width="2.5" stroke-linecap="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" vector-effect="non-scaling-stroke"/>
      </svg>
      <div class="st" data-x="1100" data-y="100" style="left:91.67%;top:30.3%"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg><span class="sl"><%= t('landing.road.1') %></span></div>
      <div class="st" data-x="900" data-y="190" style="left:75%;top:57.6%"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg><span class="sl"><%= t('landing.road.2') %></span></div>
      <div class="st" data-x="700" data-y="100" style="left:58.33%;top:30.3%"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/><path d="m14.5 17.5 2 2 4-4"/></svg><span class="sl"><%= t('landing.road.3') %></span></div>
      <div class="st big" data-x="500" data-y="190" style="left:41.67%;top:57.6%"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg><span class="sl"><%= t('landing.road.4') %><br><span class="tg"><%= t('landing.road.4b') %></span></span></div>
      <div class="st" data-x="300" data-y="100" style="left:25%;top:30.3%"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><span class="sl"><%= t('landing.road.5') %></span></div>
      <div class="st" data-x="100" data-y="190" style="left:8.33%;top:57.6%"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg><span class="sl"><%= t('landing.road.6') %></span></div>
    </div>

    <div class="rm-m" style="margin:56px auto 24px;max-width:340px;gap:8px">
      <div class="rm" data-rm="1" style="width:96px;height:660px;flex:none">
        <svg viewBox="0 0 100 660" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible">
          <path d="M70 0 L70 55 C70 110 30 110 30 165 C30 220 70 220 70 275 C70 330 30 330 30 385 C30 440 70 440 70 495 C70 550 30 550 30 605 L30 660" fill="none" stroke="#E4DFD6" stroke-width="2" vector-effect="non-scaling-stroke"/>
          <path data-path="1" d="M70 0 L70 55 C70 110 30 110 30 165 C30 220 70 220 70 275 C70 330 30 330 30 385 C30 440 70 440 70 495 C70 550 30 550 30 605 L30 660" fill="none" stroke="#B8964A" stroke-width="2.5" stroke-linecap="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" vector-effect="non-scaling-stroke"/>
        </svg>
        <div class="st" data-x="70" data-y="55" style="left:70%;top:8.33%"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg></div>
        <div class="st" data-x="30" data-y="165" style="left:30%;top:25%"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg></div>
        <div class="st" data-x="70" data-y="275" style="left:70%;top:41.67%"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/><path d="m14.5 17.5 2 2 4-4"/></svg></div>
        <div class="st big" data-x="30" data-y="385" style="left:30%;top:58.33%;width:56px;height:56px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg></div>
        <div class="st" data-x="70" data-y="495" style="left:70%;top:75%"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></div>
        <div class="st" data-x="30" data-y="605" style="left:30%;top:91.67%"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></div>
      </div>
      <div style="flex:1;display:grid;grid-template-rows:repeat(6,110px);font-family:'Noto Kufi Arabic',sans-serif;font-weight:600;font-size:15px;color:var(--ink)">
        <div style="display:flex;align-items:center"><%= t('landing.road.1') %></div>
        <div style="display:flex;align-items:center"><%= t('landing.road.2') %></div>
        <div style="display:flex;align-items:center"><%= t('landing.road.3') %></div>
        <div style="display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:4px"><%= t('landing.road.4') %><span class="tg"><%= t('landing.road.4b') %></span></div>
        <div style="display:flex;align-items:center"><%= t('landing.road.5') %></div>
        <div style="display:flex;align-items:center"><%= t('landing.road.6') %></div>
      </div>
    </div>

    <div class="rv" style="display:flex;justify-content:center;margin-top:48px"><a class="btn gold" href="/auth/login"><%= t('landing.road.cta') %></a></div>
  </div>
</section>

<section class="sec" style="background:var(--bg2);padding-top:96px">
  <div class="wrap two" style="align-items:start;gap:56px">
    <div id="gift" style="scroll-margin-top:96px">
      <h2 class="rv"><%= t('landing.gift.before') %> <span class="gt"><%= t('landing.gift.em') %></span></h2>
      <div class="rv" style="background:var(--card);border:1px solid var(--line);border-radius:28px;padding:24px;margin-top:36px;transition-delay:.1s">
        <div class="dashbox">
          <div class="k" style="display:flex;align-items:center;gap:10px;font-weight:700;font-size:17px;margin-bottom:16px"><span style="color:var(--gold-text);display:flex"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg></span><%= t('landing.gift.title') %></div>
          <div style="display:flex;flex-direction:column;gap:10px;font-size:16px">
            <div style="display:flex;gap:10px;align-items:flex-start"><span style="color:var(--gold-text);display:flex;margin-top:8px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span><%= t('landing.gift.i1') %></div>
            <div style="display:flex;gap:10px;align-items:flex-start"><span style="color:var(--gold-text);display:flex;margin-top:8px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span><%= t('landing.gift.i2') %></div>
