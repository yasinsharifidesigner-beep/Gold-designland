<%- include('partials/open', { active: 'projects', mainClass: 'dash', title: t('projects.title') }) %>
<header class="head gap">
  <h1 class="h1s"><%= t('projects.title') %></h1>
  <p class="sub"><%= t('projects.sub') %></p>
</header>
<div class="pg">
  <a class="pcard new" href="/panel/chats/idea">
    <span class="plus"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F1E1C" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg></span>
    <b><%= t('dash.startProject') %></b>
  </a>
  <% projects.forEach(function (p) { %>
    <article class="pcard">
      <a class="pcard-hit" href="/panel/projects/<%= p.slug %>" aria-label="<%= p.title %>"></a>
      <div class="pcard-top"><span class="th"><%- include('partials/sketch', { shape: p.shape }) %></span><div><h3><%= p.title %></h3><div class="date"><%= p.when %></div></div></div>
      <%- include('partials/track', { now: p.now, fill: p.fill, small: true, links: p.links }) %>
    </article>
  <% }) %>
</div>
<%- include('partials/close', { auth: false }) %>
