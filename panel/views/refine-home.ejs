<%- include('partials/open', { active: 'refine', mainClass: 'dash', title: t('nav.refine') }) %>
<header class="head gap">
  <h1 class="h1s"><%= t('nav.refine') %></h1>
  <p class="sub"><%= t('refine.sub') %></p>
</header>
<% if (!pending.length && !picked.length) { %>
  <p class="sub"><%= t('refine.empty') %></p>
<% } %>
<% if (pending.length) { %>
  <h2 class="group-t"><%= t('refine.pending') %></h2>
  <div class="pg">
    <% pending.forEach(function (p) { %>
      <article class="pcard">
        <a class="pcard-hit" href="/panel/projects/<%= p.slug %>/refine" aria-label="<%= p.title %>"></a>
        <div class="pcard-top"><span class="th"><%- include('partials/sketch', { shape: p.shape }) %></span><div><h3><%= p.title %></h3><div class="date"><%= p.when %></div></div></div>
        <%- include('partials/track', { now: p.now, fill: p.fill, small: true, links: null }) %>
      </article>
    <% }) %>
  </div>
<% } %>
<% if (picked.length) { %>
  <h2 class="group-t"><%= t('refine.picked') %></h2>
  <div class="pg">
    <% picked.forEach(function (p) { %>
      <article class="pcard">
        <a class="pcard-hit" href="/panel/projects/<%= p.slug %>" aria-label="<%= p.title %>"></a>
        <div class="pcard-top"><span class="th"><%- include('partials/sketch', { shape: p.shape }) %></span><div><h3><%= p.title %></h3><div class="date"><%= p.when %></div></div></div>
        <%- include('partials/track', { now: p.now, fill: p.fill, small: true, links: null }) %>
      </article>
    <% }) %>
  </div>
<% } %>
<%- include('partials/close', { auth: false }) %>
