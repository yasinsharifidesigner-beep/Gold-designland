<%- include('partials/open', { active: 'refine', mainClass: 'talk', title: t('nav.refine') }) %>
<header class="cbar">
  <a class="back" href="<%= back %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 5l7 7-7 7"/></svg><%= t('nav.idea') %></a>
  <h1><%= t('nav.refine') %></h1>
  <span class="cbar-sp"></span>
</header>
<div class="thread tight">
  <% messages.forEach(function (m) { %>
    <div class="msg <%= m.role === 'user' ? 'me' : 'asst' %>"><%= m.text %></div>
  <% }) %>
  <div class="tools">
    <div class="r">
      <a class="tbtn pri" href="/panel/chats/assistant/<%= assistId %>"><%= t('assistant.continue') %></a>
      <a class="tbtn" href="/panel/chats/image/<%= imageId %>"><%= t('image.make') %></a>
    </div>
    <div class="l">
      <a class="ib" href="/panel/projects/<%= project.slug %>/download" title="<%= t('common.download') %>" aria-label="<%= t('common.download') %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 4v12M7 11l5 5 5-5M5 20h14"/></svg></a>
      <button class="ib" type="button" id="share" data-link="<%= share %>" data-copied="<%= t('common.copied') %>" title="<%= t('common.share') %>" aria-label="<%= t('common.share') %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="12" r="2"/><circle cx="16" cy="7" r="2"/><circle cx="16" cy="17" r="2"/><path d="M8 11l6-3M8 13l6 3"/></svg></button>
      <form method="post" action="/panel/projects/<%= project.slug %>/more" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="ib" type="submit" title="<%= t('common.moreSamples') %>" aria-label="<%= t('common.moreSamples') %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12a8 8 0 0 1 13-6l3 3M20 12a8 8 0 0 1-13 6l-3-3"/><path d="M20 4v5h-5M4 20v-5h5"/></svg></button>
      </form>
    </div>
  </div>
  <div class="grid4">
    <% project.designs.forEach(function (d) { %>
      <form method="post" action="/panel/projects/<%= project.slug %>/select">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="n" value="<%= d.number %>">
        <button class="tile <%= d.selected ? 'on' : '' %>" type="submit">
          <span class="n"><%= fa(d.number) %></span>
          <% if (d.selected) { %><span class="picked"><%= t('common.selected') %></span><% } %>
          <%- include('partials/sketch', { shape: 'ring' }) %>
        </button>
      </form>
    <% }) %>
  </div>
</div>
<form class="composer w760" method="post" action="/panel/projects/<%= project.slug %>/refine">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="text" name="text" placeholder="<%= t('idea.composer') %>" aria-label="<%= t('idea.composer') %>">
  <button class="attach" type="button" title="<%= t('common.attach') %>" aria-label="<%= t('common.attach') %>"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3.5" y="5" width="17" height="14" rx="2.2"/><circle cx="9" cy="10.2" r="1.6"/><path d="M3.8 16.2 8.5 12l3.2 2.6 3-3.4 5.5 5.2"/></svg></button>
  <button class="send" type="submit" title="<%= t('common.send') %>" aria-label="<%= t('common.send') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg></button>
</form>
<%- include('partials/close', { auth: false }) %>
