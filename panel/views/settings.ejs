<%- include('partials/open', { active: 'settings', mainClass: 'set', title: t('settings.title'), logoutOpen: tab === 'logout' }) %>
<% const settingsTab = typeof tab === 'undefined' ? 'account' : tab; const openTab = (settingsTab === 'password' || settingsTab === 'appearance' || settingsTab === 'notifications') ? settingsTab : 'account'; %>
<header class="head"><h1 class="h1s"><%= t('settings.title') %></h1><p class="sub"><%= t('settings.sub') %></p></header>
<div class="board" data-open="<%= openTab %>">
  <nav class="tabs" aria-label="<%= t('settings.tabs') %>">
    <a class="tab <%= openTab === 'account' ? 'on' : '' %>" href="#account"><%- include('partials/ico', { name: 'user' }) %><%= t('settings.account') %></a>
    <a class="tab <%= openTab === 'password' ? 'on' : '' %>" href="#password"><%- include('partials/ico', { name: 'lock' }) %><%= t('settings.password') %></a>
    <a class="tab <%= openTab === 'appearance' ? 'on' : '' %>" href="#appearance"><%- include('partials/ico', { name: 'sun' }) %><%= t('settings.appearance') %></a>
    <a class="tab <%= openTab === 'notifications' ? 'on' : '' %>" href="#notifications"><%- include('partials/ico', { name: 'bell' }) %><%= t('settings.notes') %></a>
    <div class="tabs-foot"><a class="tab out" href="#logout"><%- include('partials/ico', { name: 'out' }) %><%= t('settings.logout') %></a></div>
  </nav>
  <section class="pane">
    <div data-tab="password" <%= openTab === 'password' ? '' : 'hidden' %>>
      <h2><%= t('settings.password') %></h2>
      <form class="form1" method="post" action="/panel/settings/password">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (showCurrent) { %><label class="field"><span><%= t('settings.current') %></span><input type="password" name="current"></label><% } %>
        <label class="field"><span><%= t('settings.next') %></span><input type="password" name="next" aria-describedby="passhint"></label>
        <p class="passhint" id="passhint" data-pass-hint data-pass-input="next"><span class="passhint-mark" aria-hidden="true"></span><span><%= t('auth.passHint') %></span></p>
        <label class="field"><span><%= t('settings.again') %></span><input type="password" name="again"></label>
        <button class="btn form" type="submit"><%= t('settings.changePass') %></button>
      </form>
    </div><div data-tab="appearance" <%= openTab === 'appearance' ? '' : 'hidden' %>>
      <h2><%= t('settings.appearance') %></h2>
      <form class="themes" method="post" action="/panel/settings/appearance">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="theme <%= user.theme !== 'dark' ? 'on' : '' %>" name="theme" value="light" type="submit"><span class="mini light"><i><em></em></i><div><u></u><span><b></b><b></b></span></div></span><span class="lbl"><%= t('settings.light') %></span></button>
        <button class="theme <%= user.theme === 'dark' ? 'on' : '' %>" name="theme" value="dark" type="submit"><span class="mini dark"><i><em></em></i><div><u></u><span><b></b><b></b></span></div></span><span class="lbl"><%= t('settings.dark') %></span></button>
      </form>
    </div><div data-tab="notifications" <%= openTab === 'notifications' ? '' : 'hidden' %>>
      <h2><%= t('settings.notes') %></h2>
      <div class="notes">
        <form method="post" action="/panel/settings/notifications">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="note-row"><div class="ntxt"><b><%= t('settings.noteSub') %></b><p><%= t('settings.noteSubP') %></p></div>
            <button class="sw <%= user.notifySubEnd ? 'on' : '' %>" name="key" value="sub" type="submit" aria-label="<%= t('settings.noteSub') %>"><i></i></button></div>
        </form>
        <form method="post" action="/panel/settings/notifications">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="note-row"><div class="ntxt"><b><%= t('settings.noteSession') %></b><p><%= t('settings.noteSessionP') %></p></div>
            <button class="sw <%= user.notifyNewSession ? 'on' : '' %>" name="key" value="session" type="submit" aria-label="<%= t('settings.noteSession') %>"><i></i></button></div>
        </form>
      </div>
    </div><div data-tab="account" <%= openTab === 'account' ? '' : 'hidden' %>>
      <header class="profile">
        <div class="ph">
          <div class="avt"><%- include('partials/ico', { name: 'user' }) %></div>
          <form method="post" action="/panel/settings/avatar" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="chg" aria-label="<%= t('settings.changePhoto') %>"><input type="file" name="avatar" accept="image/*" hidden onchange="this.form.submit()"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1F1E1C" stroke-width="1.8"><path d="M4.5 8.5h3l1.5-2h6l1.5 2h3A1.5 1.5 0 0 1 21 10v8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18v-8A1.5 1.5 0 0 1 4.5 8.5z"/><circle cx="12" cy="14" r="3.2"/></svg></label>
          </form>
        </div>
        <div class="who"><h2><%= user.firstName %> <%= user.lastName %></h2><p class="phone"><%= masked %></p></div>
      </header>
      <form class="form2" method="post" action="/panel/settings/account">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="field"><span><%= t('settings.first') %></span><input name="first" value="<%= user.firstName %>"></label>
        <label class="field"><span><%= t('settings.last') %></span><input name="last" value="<%= user.lastName %>"></label>
        <label class="field"><span><%= t('settings.birth') %></span>
          <span class="dates">
            <select class="sel" name="d"><% for (let i=1;i<=31;i++) { %><option value="<%= i %>" <%= user.birth.d===i?'selected':'' %>><%= fa(i) %></option><% } %></select>
            <select class="sel" name="m"><% months.forEach(function (m,i) { %><option value="<%= i+1 %>" <%= user.birth.m===i+1?'selected':'' %>><%= m %></option><% }) %></select>
            <select class="sel" name="y"><% for (let y=1405;y>=1320;y--) { %><option value="<%= y %>" <%= user.birth.y===y?'selected':'' %>><%= fa(y) %></option><% } %></select>
          </span>
        </label>
        <div class="field">
          <span class="labrow"><span><%= t('settings.mobile') %></span><a href="/panel/settings?phone=1#account"><%= t('settings.changePhone') %></a></span>
          <% if (changePhone) { %>
            <input class="phone" name="newPhone" placeholder="<%= t('auth.phonePh') %>" value="<%= newPhone || '' %>">
          <% } else { %>
            <input class="phone" value="<%= masked %>" readonly>
          <% } %>
        </div>
        <button class="btn form" type="submit"><%= t('settings.save') %></button>
      </form>
      <% if (changePhone && !codeSent) { %>
        <form method="post" action="/panel/settings/phone" style="margin-top:12px">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="newPhone" value="<%= newPhone || '' %>">
          <button class="btn form" type="submit"><%= t('auth.sendCode') %></button>
        </form>
      <% } %>
      <% if (codeSent) { %>
        <div class="oknote" style="margin-top:16px"><%= t('auth.codeFor') %> <b class="phone"><%= phoneShow %></b> <%= t('auth.codeSentTail') %></div>
        <form method="post" action="/panel/settings/phone/verify">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <%- include('partials/otp') %>
          <button class="btn form" type="submit"><%= t('auth.confirm') %></button>
        </form>
      <% } %>
    </div>
    <%- include('partials/toast-seed', { kind: 'error', text: error }) %>
    <%- include('partials/toast-seed', { kind: 'success', text: ok }) %>
  </section>
</div>
<%- include('partials/close', { auth: false, logoutOpen: tab === 'logout' }) %>
