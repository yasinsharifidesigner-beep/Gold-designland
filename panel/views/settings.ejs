<%- include('partials/open', { active: 'تنظیمات', mainClass: 'set', title: 'تنظیمات', logoutOpen: tab === 'logout' }) %>
<header class="head"><h1 class="h1s">تنظیمات</h1><p class="sub">حساب، ظاهر و اعلان‌ها را از اینجا مدیریت کن.</p></header>
<div class="board">
  <nav class="tabs" aria-label="بخش‌های تنظیمات">
    <a class="tab on" href="#account"><%- include('partials/ico', { name: 'user' }) %>اطلاعات حساب</a>
    <a class="tab" href="#password"><%- include('partials/ico', { name: 'lock' }) %>رمز عبور</a>
    <a class="tab" href="#appearance"><%- include('partials/ico', { name: 'sun' }) %>ظاهر</a>
    <a class="tab" href="#notifications"><%- include('partials/ico', { name: 'bell' }) %>اعلان‌ها</a>
    <div class="tabs-foot"><a class="tab out" href="#logout"><%- include('partials/ico', { name: 'out' }) %>خروج از حساب</a></div>
  </nav>
  <section class="pane">
    <div data-tab="password" hidden>
      <h2>رمز عبور</h2>
      <form class="form1" method="post" action="/panel/settings/password">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (showCurrent) { %><label class="field"><span>رمز فعلی</span><input type="password" name="current"></label><% } %>
        <label class="field"><span>رمز جدید</span><input type="password" name="next"></label>
        <label class="field"><span>تکرار رمز جدید</span><input type="password" name="again"></label>
        <button class="btn form" type="submit">تغییر رمز</button>
      </form>
    </div><div data-tab="appearance" hidden>
      <h2>ظاهر</h2>
      <form class="themes" method="post" action="/panel/settings/appearance">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="theme <%= user.theme !== 'dark' ? 'on' : '' %>" name="theme" value="light" type="submit"><span class="mini light"><i><em></em></i><div><u></u><span><b></b><b></b></span></div></span><span class="lbl">روشن</span></button>
        <button class="theme <%= user.theme === 'dark' ? 'on' : '' %>" name="theme" value="dark" type="submit"><span class="mini dark"><i><em></em></i><div><u></u><span><b></b><b></b></span></div></span><span class="lbl">تیره</span></button>
      </form>
    </div><div data-tab="notifications" hidden>
      <h2>اعلان‌ها</h2>
      <div class="notes">
        <form method="post" action="/panel/settings/notifications">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="note-row"><div class="ntxt"><b>پیامک پایان اشتراک</b><p>یک روز مانده به پایان اشتراک، با پیامک خبرت می‌کنیم.</p></div>
            <button class="sw <%= user.notifySubEnd ? 'on' : '' %>" name="key" value="sub" type="submit" aria-label="پیامک پایان اشتراک"><i></i></button></div>
        </form>
        <form method="post" action="/panel/settings/notifications">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="note-row"><div class="ntxt"><b>پیامک جلسهٔ جدید دوره‌ها</b><p>وقتی جلسهٔ تازه‌ای به دوره‌هایت اضافه شود، با پیامک باخبرت می‌کنیم.</p></div>
            <button class="sw <%= user.notifyNewSession ? 'on' : '' %>" name="key" value="session" type="submit" aria-label="پیامک جلسهٔ جدید دوره‌ها"><i></i></button></div>
        </form>
      </div>
    </div><div data-tab="account">
      <header class="profile">
        <div class="ph">
          <div class="avt"><%- include('partials/ico', { name: 'user' }) %></div>
          <form method="post" action="/panel/settings/avatar" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="chg" aria-label="تغییر عکس پروفایل"><input type="file" name="avatar" accept="image/*" hidden onchange="this.form.submit()"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1F1E1C" stroke-width="1.8"><path d="M4.5 8.5h3l1.5-2h6l1.5 2h3A1.5 1.5 0 0 1 21 10v8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18v-8A1.5 1.5 0 0 1 4.5 8.5z"/><circle cx="12" cy="14" r="3.2"/></svg></label>
          </form>
        </div>
        <div class="who"><h2><%= user.firstName %> <%= user.lastName %></h2><p class="phone"><%= masked %></p></div>
      </header>
      <form class="form2" method="post" action="/panel/settings/account">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="field"><span>نام</span><input name="first" value="<%= user.firstName %>"></label>
        <label class="field"><span>نام خانوادگی</span><input name="last" value="<%= user.lastName %>"></label>
        <label class="field"><span>تاریخ تولد</span>
          <span class="dates">
            <select class="sel" name="d"><% for (let i=1;i<=31;i++) { %><option value="<%= i %>" <%= user.birth.d===i?'selected':'' %>><%= fa(i) %></option><% } %></select>
            <select class="sel" name="m"><% months.forEach(function (m,i) { %><option value="<%= i+1 %>" <%= user.birth.m===i+1?'selected':'' %>><%= m %></option><% }) %></select>
            <select class="sel" name="y"><% for (let y=1405;y>=1320;y--) { %><option value="<%= y %>" <%= user.birth.y===y?'selected':'' %>><%= fa(y) %></option><% } %></select>
          </span>
        </label>
        <div class="field">
          <span class="labrow"><span>شمارهٔ موبایل</span><a href="/panel/settings?phone=1#account">تغییر شماره</a></span>
          <% if (changePhone) { %>
            <input class="phone" name="newPhone" placeholder="شماره موبایل" value="<%= newPhone || '' %>">
          <% } else { %>
            <input class="phone" value="<%= masked %>" readonly>
          <% } %>
        </div>
        <button class="btn form" type="submit">ذخیره</button>
      </form>
      <% if (changePhone && !codeSent) { %>
        <form method="post" action="/panel/settings/phone" style="margin-top:12px">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="newPhone" value="<%= newPhone || '' %>">
          <button class="btn form" type="submit">ارسال کد</button>
        </form>
      <% } %>
      <% if (codeSent) { %>
        <div class="oknote" style="margin-top:16px">کد برای <b class="phone"><%= phoneShow %></b> ارسال شد</div>
        <form method="post" action="/panel/settings/phone/verify">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="otp" id="otp"><% for (let i=0;i<5;i++) { %><input name="d<%= i %>" maxlength="1" inputmode="numeric"><% } %></div>
          <button class="btn form" type="submit">تأیید</button>
        </form>
      <% } %>
    </div>
    <% if (error) { %><p class="err" style="text-align:right"><%= error %></p><% } %>
    <% if (ok) { %><p class="oknote"><%= ok %></p><% } %>
  </section>
</div>
<%- include('partials/close', { auth: false, logoutOpen: tab === 'logout' }) %>
