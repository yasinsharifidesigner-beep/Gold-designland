<%- include('partials/open', { active: 'اشتراک', mainClass: 'dash', title: 'اشتراک' }) %>
<header class="head gap">
  <h1 class="h1s">اشتراک</h1>
  <p class="sub"><%= user.subscription ? 'اشتراکت فعاله؛ هر وقت خواستی، می‌تونی اشتراک دیگه‌ای انتخاب کنی.' : 'با هدیهٔ خوش‌آمدگویی شروع کردی؛ هر وقت آماده بودی، اشتراک مناسب خودت را انتخاب کن.' %></p>
</header>
<section class="status">
  <div>
    <h2><%= user.subscription ? ('اشتراک ' + user.subscription.name) : 'اشتراک هدیه' %></h2>
    <% if (user.subscription) { %><small>شروع: <%= user.subscription.start %> — پایان: <%= user.subscription.end %></small><% } %>
  </div>
  <% if (user.subscription) { %>
    <%- include('partials/ring', { num: user.subscription.pct, label: 'از اشتراکت باقی مانده', offset: user.subscription.offset, big: true }) %>
  <% } else { %>
    <%- include('partials/ring', { num: fa(giftLeft), label: 'از ' + fa(user.giftTotal) + ' پیام هدیه باقی مانده', offset: 0, big: true }) %>
  <% } %>
</section>
<div class="plans">
  <% plans.forEach(function (p) { %>
    <article class="plan <%= p.featured ? 'featured' : '' %>">
      <% if (p.featured) { %><span class="tag">پیشنهاد ما</span><% } %>
      <h3><%= p.name %></h3>
      <div class="price"><b class="num"><%= money(p.price) %></b><span>تومان در ماه</span></div>
      <ul class="feats"><% p.features.forEach(function (f) { %><li><svg width="20" height="20" viewBox="0 0 24 24"><defs><linearGradient id="g<%= p.code %>" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#FFF6DA"/><stop offset="35%" stop-color="#F1DA9A"/><stop offset="65%" stop-color="#DDBE74"/><stop offset="100%" stop-color="#BF9B52"/></linearGradient></defs><circle cx="12" cy="12" r="10" fill="url(#g<%= p.code %>)"/><path d="M7.5 12.3l3 3.1 6-6.2" fill="none" stroke="#1F1E1C" stroke-width="2" stroke-linecap="round"/></svg><span><%= f %></span></li><% }) %></ul>
      <a class="<%= p.featured ? 'btn block' : 'btn-sec' %>" style="width:100%" href="/panel/subscription/<%= p.code %>">انتخاب این اشتراک</a>
    </article>
  <% }) %>
</div>
<%- include('partials/close', { auth: false }) %>
